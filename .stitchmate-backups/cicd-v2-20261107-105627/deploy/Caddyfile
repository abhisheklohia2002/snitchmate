# Replace this with the DNS hostname you control.
stitchmate.example.com {
    encode zstd gzip
    header {
      X-Content-Type-Options nosniff
      Referrer-Policy strict-origin-when-cross-origin
    }
    handle /api/* {
      reverse_proxy api:4000
    }
    handle {
      reverse_proxy web:3000
    }
}
