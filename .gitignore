# StitchMate monorepo: Next.js + NestJS + worker + Prisma + pnpm

# Dependencies and package-manager caches
node_modules/
.pnpm-store/
.pnp.*
.yarn/cache/
.yarn/unplugged/

# Next.js / Turborepo / deployment caches
.next/
out/
.vercel/
.turbo/

# Compiled output and TypeScript caches
dist/
build/
coverage/
*.tsbuildinfo
next-env.d.ts

# Secrets and local environment configuration
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.*.sample
*.pem
*.p12
*.pfx
*.secret
.ssh/
id_rsa
id_ed25519

# Logs and diagnostic output
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local databases, uploads, and Docker data
*.sqlite
*.sqlite3
*.db
*.db-journal
uploads/
storage/
minio-data/
postgres-data/
redis-data/
docker-data/
backups/
*.sql.gz
*.dump

# Temporary/test artifacts
.tmp/
tmp/
temp/
.cache/
playwright-report/
test-results/

# Editor and operating system files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# IMPORTANT: Keep these in Git:
# pnpm-lock.yaml
# pnpm-workspace.yaml
# prisma/schema.prisma and prisma/migrations/
# Dockerfile(s), compose files, Caddyfile, .github/workflows/
# .env.example (placeholders only; never actual credentials)

