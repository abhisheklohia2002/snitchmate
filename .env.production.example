# Copy to /opt/stitchmate/shared/.env.production on the VPS. NEVER commit actual values.
# Use distinct production credentials; no local/company/test secrets for public launch.
NODE_ENV=production
PUBLIC_LAUNCH_ENABLED=false
PORT=4000
WEB_ORIGIN=https://stitchmate.online
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_OTP_CHANNEL=whatsapp

# Use URL-safe random hex for POSTGRES_PASSWORD, and paste the SAME value into DATABASE_URL.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
DATABASE_URL=postgresql://stitchmate:REPLACE_WITH_RANDOM_HEX@postgres:5432/stitchmate?schema=public
REDIS_URL=redis://redis:6379

SESSION_SECRET=REPLACE_WITH_RANDOM_64_PLUS_CHARS
OTP_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_64_PLUS_CHARS
MOCK_OTP_ENABLED=false
MOCK_PAYMENT_ENABLED=false
ENABLE_DEMO_PAYMENT_CONFIRM=false

SMS_PROVIDER=msgkart
MSGKART_API_URL=https://alb-backend.msgkart.com/api/v1
MSGKART_BUSINESS_ID=YOUR_AUTHORIZED_BUSINESS_ID
MSGKART_API_KEY=YOUR_AUTHORIZED_MSGKART_KEY
MSGKART_PHONE_ID=YOUR_AUTHORIZED_PHONE_ID
MSGKART_OTP_TEMPLATE_NAME=YOUR_APPROVED_OTP_TEMPLATE
MSGKART_OTP_TEMPLATE_LANGUAGE=en_US
MSGKART_OTP_BUTTON_MODE=copy_code
MSGKART_HANDOFF_TEMPLATE_NAME=YOUR_APPROVED_HANDOFF_TEMPLATE

# Non-public staging can use your own TEST keys. Never turn on PUBLIC_LAUNCH_ENABLED
# until LIVE credentials are StitchMate-owned and launch verification has passed.
RAZORPAY_KEY_ID=rzp_test_YOUR_TEST_KEY
RAZORPAY_KEY_SECRET=YOUR_TEST_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_TEST_WEBHOOK_SECRET

NOTIFICATION_PROVIDER=msgkart
MSGKART_STATUS_TEMPLATE_NAME=YOUR_APPROVED_UTILITY_TEMPLATE
MSGKART_STATUS_TEMPLATE_LANGUAGE=en_US

AWS_REGION=blr1
S3_ENDPOINT=https://blr1.digitaloceanspaces.com
S3_BUCKET=YOUR_PRIVATE_SPACE
S3_ACCESS_KEY_ID=YOUR_SPACES_ACCESS_KEY
S3_SECRET_ACCESS_KEY=YOUR_SPACES_SECRET
S3_FORCE_PATH_STYLE=false

PLATFORM_COMMISSION_BPS=1500
FIT_CLAIM_WINDOW_HOURS=48
ADMIN_BOOTSTRAP_PHONE=+91ADMIN_NUMBER
COURIER_BOOTSTRAP_PHONE=+91COURIER_NUMBER
